                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.environment.set(\"instructorToken\", data.token);",
                  "}",
                  "if (pm.response.code === 200) pm.environment.set(\"instructorUserId\", pm.response.json().userId);"
                ]
              }
            }
          ]
        },
