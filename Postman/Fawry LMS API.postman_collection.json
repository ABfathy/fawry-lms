    {
      "name": "06 - Enrollment and payment",
      "item": [
        {
          "name": "Create enrollment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/enrollments",
            "description": "Creates a pending enrollment for the registered student and instructor-owned course.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{studentId}},\n  \"courseId\": {{courseId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.environment.set(\"enrollmentId\", data.id);",
                  "}",
                  "if (pm.response.code === 201) pm.environment.set(\"paymentReference\", pm.response.json().paymentReference);"
                ]
              }
            }
          ]
        },
        {
          "name": "List enrollments for student",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/enrollments?studentId={{studentId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get enrollment",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/enrollments/{{enrollmentId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Process PAID webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Webhook-Timestamp",
                "value": "{{webhookTimestamp}}",
                "type": "text"
              },
              {
                "key": "X-Webhook-Signature",
                "value": "{{webhookSignature}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/payments/webhook",
            "description": "The pre-request script signs timestamp + newline + paymentReference + newline + uppercased status with the local PAYMENT_WEBHOOK_SECRET.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentReference\": \"{{paymentReference}}\",\n  \"status\": \"PAID\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.environment.get(\"webhookSecret\");",
                  "const paymentReference = pm.environment.get(\"paymentReference\");",
                  "if (!secret || !paymentReference) {",
                  "    throw new Error(\"Run Create enrollment first and import the local Postman environment containing webhookSecret.\");",
                  "}",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const message = timestamp + \"\\n\" + paymentReference.trim() + \"\\nPAID\";",
                  "const toBytes = (value) => Uint8Array.from(Array.from(value, (character) => character.charCodeAt(0)));",
                  "const key = await crypto.subtle.importKey(",
                  "    \"raw\",",
                  "    toBytes(secret),",
                  "    { name: \"HMAC\", hash: \"SHA-256\" },",
                  "    false,",
                  "    [\"sign\"]",
                  ");",
                  "const signatureBuffer = await crypto.subtle.sign(\"HMAC\", key, toBytes(message));",
                  "const signature = Array.from(new Uint8Array(signatureBuffer), (byte) => byte.toString(16).padStart(2, \"0\")).join(\"\");",
                  "pm.environment.set(\"webhookTimestamp\", timestamp);",
                  "pm.environment.set(\"webhookSignature\", signature);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const result = pm.response.json();",
                  "pm.test(\"Enrollment is active after payment\", function () {",
                  "    pm.expect(result.enrollmentStatus).to.eql(\"ACTIVE\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List all enrollments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/enrollments",
            "auth": {
