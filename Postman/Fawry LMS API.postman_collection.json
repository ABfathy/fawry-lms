{
  "info": {
    "_postman_id": "a70db36c-b899-4cd4-bdd2-43561d3f52cf",
    "name": "Fawry LMS API",
    "description": "End-to-end API requests for auth, student and instructor profiles, courses, enrollment, and signed payment webhooks. Run in the order described in Postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Send after the bootstrap account has been promoted to ADMIN in the local database.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.environment.set(\"adminToken\", data.token);",
                  "}",
                  "if (pm.response.code === 200) pm.environment.set(\"adminUserId\", pm.response.json().userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Creates a STUDENT account and saves its access token. The profile row ID is captured by Admin > List students.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Local Student\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"studentEmail\", \"postman-student-\" + Date.now() + \"@example.test\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.environment.set(\"studentToken\", data.token);",
                  "}",
                  "if (pm.response.code === 201 || pm.response.code === 200) pm.environment.set(\"studentUserId\", pm.response.json().userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.environment.set(\"studentToken\", data.token);",
                  "}",
                  "if (pm.response.code === 201 || pm.response.code === 200) pm.environment.set(\"studentUserId\", pm.response.json().userId);"
                ]
              }
            }
          ]
        }
      ],
      "description": "Admin login requires the bootstrap account to have been promoted first."
    },
    {
      "name": "02 - Student profiles",
      "item": [
        {
          "name": "List students (capture registered profile ID)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/students",
            "description": "Admin only. Saves studentId by matching the registered student's email.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const profiles = pm.response.json();",
                  "const profile = profiles.find((item) => item.email === pm.environment.get(\"studentEmail\"));",
                  "if (profile) {",
                  "    pm.environment.set(\"studentId\", profile.id);",
                  "} else {",
                  "    console.warn(\"Register the Postman student before running this request.\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get own student profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/students/{{studentId}}",
