                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel enrollment",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/v1/enrollments/{{enrollmentId}}/cancel",
            "description": "Run after the successful webhook request.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const result = pm.response.json();",
                  "pm.test(\"Enrollment is canceled\", function () {",
                  "    pm.expect(result.enrollmentStatus).to.eql(\"CANCELED\");",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Create an enrollment, sign a PAID webhook using the local secret, inspect it, then cancel it."
    }
