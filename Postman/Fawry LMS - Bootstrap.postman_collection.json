{
  "info": {
    "_postman_id": "4f5012c5-267a-4009-b366-e86901b0f25b",
    "name": "Fawry LMS - Bootstrap",
    "description": "First-run health check and one-time admin candidate registration. See Postman/README.md for the local SQL promotion step.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - First run",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health",
            "description": "Public endpoint. Returns the service health text.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register admin candidate (run once)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Registration creates a STUDENT account. After this request, run Postman/promote-admin.sql for the generated adminEmail, then use the API collection's Login admin request.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Local Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"adminEmail\", \"postman-admin-\" + Date.now() + \"@example.test\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.environment.set(\"bootstrapToken\", data.token);",
                  "}",
                  "if (pm.response.code === 200) pm.environment.set(\"adminUserId\", pm.response.json().userId);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
